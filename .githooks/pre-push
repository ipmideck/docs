#!/bin/sh
# Pre-push i18n gate: blocks the push when a translation is missing or left stale.
# CI runs the same script (.github/workflows/ci.yml). Activate per-clone with:
#   git config core.hooksPath .githooks
# Override a deliberate en-only change with [i18n-skip] in a commit subject.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote ref: nothing to check
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  node .github/scripts/check-docs-i18n.mjs --since "$base" --head "$local_sha" || status=1
done
if [ "$status" -ne 0 ]; then
  echo "[pre-push] i18n gate FAILED — push blocked." >&2
fi
exit $status
